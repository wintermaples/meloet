{
  "version": "0.2.0",
  "configurations": [
    {
      // The page comes from vite (localhost:1420), not from an embedded ui/dist: changes to ui/ show in the window at once.
      "name": "meloet (debug)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "meloet-app", "--bin", "meloet", "--no-default-features"],
        "filter": { "name": "meloet", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}",
      // The snap build of VS Code points the GTK and GLib variables at old files inside the snap and passes
      // them to child processes. GTK then reads old GSettings schemas and crashes, so the original values
      // (*_VSCODE_SNAP_ORIG) are put back. Without the snap build they are all empty.
      "env": {
        "RUST_BACKTRACE": "1",
        "XDG_DATA_DIRS": "${env:XDG_DATA_DIRS_VSCODE_SNAP_ORIG}",
        "XDG_CONFIG_DIRS": "${env:XDG_CONFIG_DIRS_VSCODE_SNAP_ORIG}",
        "GSETTINGS_SCHEMA_DIR": "${env:GSETTINGS_SCHEMA_DIR_VSCODE_SNAP_ORIG}",
        "GIO_MODULE_DIR": "${env:GIO_MODULE_DIR_VSCODE_SNAP_ORIG}",
        "GTK_PATH": "${env:GTK_PATH_VSCODE_SNAP_ORIG}",
        "GTK_EXE_PREFIX": "${env:GTK_EXE_PREFIX_VSCODE_SNAP_ORIG}",
        "GTK_IM_MODULE_FILE": "${env:GTK_IM_MODULE_FILE_VSCODE_SNAP_ORIG}",
        "GDK_PIXBUF_MODULE_FILE": "${env:GDK_PIXBUF_MODULE_FILE_VSCODE_SNAP_ORIG}",
        "GDK_PIXBUF_MODULEDIR": "${env:GDK_PIXBUF_MODULEDIR_VSCODE_SNAP_ORIG}",
        "LOCPATH": "${env:LOCPATH_VSCODE_SNAP_ORIG}"
      },
      "sourceLanguages": ["rust"],
      // WebKit's JavaScriptCore stops threads with SIGUSR1 during GC; pass it on quietly so the debugger does not stop there.
      // SIGCHLD: the plugin scan at start ends hundreds of child processes. When that signal came while WebKit's
      // libraries were loading, LLDB showed its own internal stop (_dl_debug_state) as a pause.
      "preRunCommands": [
        "process handle SIGUSR1 --stop false --notify false --pass true",
        "process handle SIGCHLD --stop false --notify false --pass true"
      ],
      "preLaunchTask": "UI: vite (dev server)"
    },
    {
      // The bridge an AI app starts (crates/meloet-mcp). It speaks MCP on stdin and stdout: type or paste one
      // JSON line per request in the terminal, for example
      //   {"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"meloet_status","arguments":{}}}
      // It finds a running meloet with 「AI とつなぐ」 on by itself. Ctrl+D ends it.
      "name": "meloet-mcp (debug)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "meloet-mcp", "--bin", "meloet-mcp"],
        "filter": { "name": "meloet-mcp", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" },
      "terminal": "integrated",
      "sourceLanguages": ["rust"]
    },
    {
      // No Tauri: the fake state (the scenes of ui/src/bridge/fake.ts) in a browser.
      "name": "UI only (browser, fake scenes)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:1420/?scene=${input:scene}&scale=${input:scale}",
      "webRoot": "${workspaceFolder}/ui",
      "preLaunchTask": "UI: vite (dev server)"
    },
    {
      // Builds the deb to hand out in an Ubuntu 24.04 container (docker) and puts it in target/deb/.
      // The user who runs it must be in the docker group.
      "name": "Build the deb (docker)",
      "type": "node-terminal",
      "request": "launch",
      "command": "scripts/build-deb.sh",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "scene",
      "type": "pickString",
      "description": "Scene",
      "options": [
        "connect1",
        "connect2",
        "connect3",
        "empty",
        "bufferFixed",
        "settings",
        "settingsAdvFixed",
        "settingsEnd",
        "settingsAdvFixedEnd",
        "longName",
        "pianoRoll",
        "mixer",
        "history",
        "shelf",
        "params"
      ],
      "default": "connect2"
    },
    {
      "id": "scale",
      "type": "pickString",
      "description": "Scale",
      "options": ["100", "125", "150"],
      "default": "100"
    }
  ]
}
