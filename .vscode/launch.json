{
  "version": "0.2.0",
  "configurations": [
    {
      // 画面は ui/dist を埋めこまず、vite（localhost:1420）から読む。ui/ を書きかえると、すぐ窓に出る。
      "name": "meloet（デバッグ）",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "meloet-app", "--bin", "meloet", "--no-default-features"],
        "filter": { "name": "meloet", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}",
      // VS Code の snap 版は、GTK と GLib の環境変数を snap の中の古い物に向けて、子のプロセスに渡す。
      // そのままだと GTK が古い設定の型（GSettings のスキーマ）を読んで落ちるので、元の値（*_VSCODE_SNAP_ORIG）に戻す。
      // snap 版でなければ、どれも空になる。
      "env": {
        "RUST_BACKTRACE": "1",
        "XDG_DATA_DIRS": "${env:XDG_DATA_DIRS_VSCODE_SNAP_ORIG}",
        "XDG_CONFIG_DIRS": "${env:XDG_CONFIG_DIRS_VSCODE_SNAP_ORIG}",
        "GSETTINGS_SCHEMA_DIR": "${env:GSETTINGS_SCHEMA_DIR_VSCODE_SNAP_ORIG}",
        "GIO_MODULE_DIR": "${env:GIO_MODULE_DIR_VSCODE_SNAP_ORIG}",
        "GTK_PATH": "${env:GTK_PATH_VSCODE_SNAP_ORIG}",
        "GTK_EXE_PREFIX": "${env:GTK_EXE_PREFIX_VSCODE_SNAP_ORIG}",
        "GTK_IM_MODULE_FILE": "${env:GTK_IM_MODULE_FILE_VSCODE_SNAP_ORIG}",
        "GDK_PIXBUF_MODULE_FILE": "${env:GDK_PIXBUF_MODULE_FILE_VSCODE_SNAP_ORIG}",
        "GDK_PIXBUF_MODULEDIR": "${env:GDK_PIXBUF_MODULEDIR_VSCODE_SNAP_ORIG}",
        "LOCPATH": "${env:LOCPATH_VSCODE_SNAP_ORIG}"
      },
      "sourceLanguages": ["rust"],
      // WebKit の JavaScriptCore は、GC のときに SIGUSR1 でスレッドを止める。デバッガがそこで止まらないように、黙って渡す。
      // SIGCHLD: 起動のときのプラグインのスキャンで、子のプロセスが何百も終わる。知らせが WebKit のライブラリの読みこみと
      // 重なると、LLDB が内部の止め所（_dl_debug_state）で一時停止して見せた（2026-11-19）。
      "preRunCommands": [
        "process handle SIGUSR1 --stop false --notify false --pass true",
        "process handle SIGCHLD --stop false --notify false --pass true"
      ],
      "preLaunchTask": "画面: vite（開発サーバ）"
    },
    {
      // Tauri なし。偽物の状態（ui/src/bridge/fake.ts の場面）をブラウザで見る。
      "name": "画面だけ（ブラウザ、偽物の場面）",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:1420/?scene=${input:scene}&scale=${input:scale}",
      "webRoot": "${workspaceFolder}/ui",
      "preLaunchTask": "画面: vite（開発サーバ）"
    }
  ],
  "inputs": [
    {
      "id": "scene",
      "type": "pickString",
      "description": "場面",
      "options": [
        "connect1",
        "connect2",
        "connect3",
        "empty",
        "bufferFixed",
        "settings",
        "settingsAdvFixed",
        "settingsEnd",
        "settingsAdvFixedEnd",
        "longName",
        "pianoRoll",
        "mixer",
        "history",
        "shelf",
        "params"
      ],
      "default": "connect2"
    },
    {
      "id": "scale",
      "type": "pickString",
      "description": "拡大率",
      "options": ["100", "125", "150"],
      "default": "100"
    }
  ]
}
