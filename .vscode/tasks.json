{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "画面: vite（開発サーバ）",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "isBackground": true,
      // vite は問題を出さない。下の background は「立ちあがった」を知るためだけ。
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "画面: ビルド（ui/dist）",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "problemMatcher": []
    },
    {
      "label": "meloet: release で動かす",
      "type": "shell",
      "command": "cargo run --release -p meloet-app",
      // launch.json の「meloet（デバッグ）」と同じ理由で、VS Code の snap 版が変えた環境変数を元に戻す。
      "options": {
        "env": {
          "XDG_DATA_DIRS": "${env:XDG_DATA_DIRS_VSCODE_SNAP_ORIG}",
          "XDG_CONFIG_DIRS": "${env:XDG_CONFIG_DIRS_VSCODE_SNAP_ORIG}",
          "GSETTINGS_SCHEMA_DIR": "${env:GSETTINGS_SCHEMA_DIR_VSCODE_SNAP_ORIG}",
          "GIO_MODULE_DIR": "${env:GIO_MODULE_DIR_VSCODE_SNAP_ORIG}",
          "GTK_PATH": "${env:GTK_PATH_VSCODE_SNAP_ORIG}",
          "GTK_EXE_PREFIX": "${env:GTK_EXE_PREFIX_VSCODE_SNAP_ORIG}",
          "GTK_IM_MODULE_FILE": "${env:GTK_IM_MODULE_FILE_VSCODE_SNAP_ORIG}",
          "GDK_PIXBUF_MODULE_FILE": "${env:GDK_PIXBUF_MODULE_FILE_VSCODE_SNAP_ORIG}",
          "GDK_PIXBUF_MODULEDIR": "${env:GDK_PIXBUF_MODULEDIR_VSCODE_SNAP_ORIG}",
          "LOCPATH": "${env:LOCPATH_VSCODE_SNAP_ORIG}"
        }
      },
      "dependsOn": "画面: ビルド（ui/dist）",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "約束の型を書き出す（Rust → TS）",
      "type": "shell",
      "command": "cargo test -p meloet-protocol",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "検査: 全部",
      "type": "shell",
      "command": "scripts/check-all.sh",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "検査: 全部（鍵盤と PipeWire のテストも）",
      "type": "shell",
      "command": "scripts/check-all.sh --devices",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "テスト: 画面（vitest）",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "テスト: Rust",
      "type": "shell",
      "command": "cargo test",
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
