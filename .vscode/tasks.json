{
  "version": "2.0.0",
  "tasks": [
    {
      // npm installed with nvm and the like is found only by a shell that reads ~/.bashrc, so npm tasks run with bash -ic.
      "label": "UI: vite (dev server)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/ui", "shell": { "executable": "/usr/bin/bash", "args": ["-ic"] } },
      "isBackground": true,
      // vite reports no problems; the background part below only tells when it is up.
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "UI: build (ui/dist)",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/ui", "shell": { "executable": "/usr/bin/bash", "args": ["-ic"] } },
      "problemMatcher": []
    },
    {
      "label": "meloet: run release",
      "type": "shell",
      "command": "cargo run --release -p meloet-app",
      // Puts back the variables the snap build of VS Code changed, for the same reason as "meloet (debug)" in launch.json.
      "options": {
        "env": {
          "XDG_DATA_DIRS": "${env:XDG_DATA_DIRS_VSCODE_SNAP_ORIG}",
          "XDG_CONFIG_DIRS": "${env:XDG_CONFIG_DIRS_VSCODE_SNAP_ORIG}",
          "GSETTINGS_SCHEMA_DIR": "${env:GSETTINGS_SCHEMA_DIR_VSCODE_SNAP_ORIG}",
          "GIO_MODULE_DIR": "${env:GIO_MODULE_DIR_VSCODE_SNAP_ORIG}",
          "GTK_PATH": "${env:GTK_PATH_VSCODE_SNAP_ORIG}",
          "GTK_EXE_PREFIX": "${env:GTK_EXE_PREFIX_VSCODE_SNAP_ORIG}",
          "GTK_IM_MODULE_FILE": "${env:GTK_IM_MODULE_FILE_VSCODE_SNAP_ORIG}",
          "GDK_PIXBUF_MODULE_FILE": "${env:GDK_PIXBUF_MODULE_FILE_VSCODE_SNAP_ORIG}",
          "GDK_PIXBUF_MODULEDIR": "${env:GDK_PIXBUF_MODULEDIR_VSCODE_SNAP_ORIG}",
          "LOCPATH": "${env:LOCPATH_VSCODE_SNAP_ORIG}"
        }
      },
      "dependsOn": "UI: build (ui/dist)",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Write the protocol types (Rust → TS)",
      "type": "shell",
      "command": "cargo test -p meloet-protocol",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Check: all",
      "type": "shell",
      "command": "scripts/check-all.sh",
      "options": { "shell": { "executable": "/usr/bin/bash", "args": ["-ic"] } },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Check: all (with keyboard and PipeWire tests)",
      "type": "shell",
      "command": "scripts/check-all.sh --devices",
      "options": { "shell": { "executable": "/usr/bin/bash", "args": ["-ic"] } },
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Test: UI (vitest)",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/ui", "shell": { "executable": "/usr/bin/bash", "args": ["-ic"] } },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: Rust",
      "type": "shell",
      "command": "cargo test",
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
