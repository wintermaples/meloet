{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meloet",
  "identifier": "dev.meloet.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "meloet",
        "width": 1280,
        "height": 800,
        "minWidth": 853,
        "minHeight": 533
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
