{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meloet",
  "identifier": "dev.meloet.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "meloet",
        "width": 1280,
        "height": 800,
        "minWidth": 853,
        "minHeight": 448
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "category": "Music",
    "license": "MIT OR Apache-2.0",
    "shortDescription": "MIDI 鍵盤ではじめる、音楽づくりのアプリ",
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.39)",
          "libasound2t64 | libasound2",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0",
          "liblilv-0-0",
          "libdbus-1-3",
          "libxcb1",
          "libstdc++6"
        ],
        "recommends": ["pipewire", "wireplumber"],
        "files": {
          "/usr/share/doc/meloet/LICENSE-MIT": "../../LICENSE-MIT",
          "/usr/share/doc/meloet/LICENSE-APACHE": "../../LICENSE-APACHE",
          "/usr/share/doc/meloet/NOTICE": "../../NOTICE"
        }
      }
    }
  }
}
