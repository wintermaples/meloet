 "sounds": [
  {"id":"salamander-grand-piano","title":"Salamander Grand Piano V3","creator":"Alexander Holm","license":"CC-BY-3.0","source":"https://archive.org/details/SalamanderGrandPianoV3","licenseUri":"http://creativecommons.org/licenses/by/3.0/","also":"SFZ+FLAC version assembled by roberto@zenvoid.org for FreePats (https://freepats.zenvoid.org/Piano/acoustic-grand-piano.html)","changes":"Kept 4 of the 16 velocity layers with the release, resonance and pedal samples, cut the silence before each sound, and converted the files to 16-bit FLAC raised to -1 dBFS (the level is restored at playback)."},
  {"id":"gregsullivan-wurlitzer-ep200","title":"Wurlitzer EP200 Electric Piano v1.1 (16-May-1999), from Greg's free electric piano samples","creator":"Greg Sullivan","license":"CC-BY-4.0","source":"http://www.sullivang.net/","licenseUri":"https://creativecommons.org/licenses/by/4.0/","also":"SFZ mapping by kinwie, https://github.com/sfzinstruments/GregSullivan.E-Pianos (CC BY 3.0, http://creativecommons.org/licenses/by/3.0/)","changes":"Cut the silence before each sound, made a crossfade loop at the end of each sample (the original loops were lost), and converted the files to 16-bit FLAC raised to -1 dBFS (the level is restored at playback)."},
  {"id":"naked-drums","title":"Naked Drums","creator":"Wilkinson Audio","license":"CC-BY-4.0","source":"https://github.com/sfzinstruments/WilkinsonAudio.NakedDrums","licenseUri":"https://creativecommons.org/licenses/by/4.0/","also":"SFZ version by kinwie","changes":"Mixed the direct and overhead microphones to stereo with the levels and pans of the author's GM preset, kept 11 sounds and 4 of the 10 takes, cut the silence before each sound, and converted the files to 16-bit FLAC."},
  {"id":"vcsl-claps","title":"Versilian Community Sample Library (VCSL)","creator":"Versilian Studios LLC","license":"CC0-1.0","source":"https://github.com/sgossner/VCSL","licenseUri":"https://creativecommons.org/publicdomain/zero/1.0/","also":null,"changes":"Used the six Clap takes, cut the silence before each sound, and converted the files to 16-bit FLAC."},
  {"id":"vcsl-pipe-organ","title":"Versilian Community Sample Library (VCSL): Pipe Organ","creator":"Simon Dalzell (Ivy Audio), Versilian Studios LLC","license":"CC0-1.0","source":"https://github.com/sgossner/VCSL","licenseUri":"https://creativecommons.org/publicdomain/zero/1.0/","also":null,"changes":"Made a crossfade loop in each manual sample, shortened the files to the loop end, cut the silence before each sound, and converted the files to 16-bit FLAC."},
  {"id":"black-and-blue-basses","title":"Black And Blue Basses","creator":"Karoryfer Samples (Drogomir Smolken)","license":"CC0-1.0","source":"https://github.com/sfzinstruments/karoryfer.black-and-blue-basses","licenseUri":"https://creativecommons.org/publicdomain/zero/1.0/","also":null,"changes":"Kept 2 of the 4 takes of the darkblack finger plucks, moved the key map down one octave so each key plays its own pitch, faded out the last 100 ms, cut the silence before each sound, and converted the files to 16-bit FLAC."},
  {"id":"vsco-2-ce-strings","title":"VS Chamber Orchestra: Community Edition","creator":"Versilian Studios LLC (Sam Gossner), Ivy Audio (Simon Dalzell); sample cutting by Elan Hickler/Soundemote","license":"CC0-1.0","source":"http://vis.versilstudios.net/vsco-community.html","licenseUri":"https://creativecommons.org/publicdomain/zero/1.0/","also":null,"changes":"Joined the violin, viola and cello section and solo double bass sustains into one key range, made a crossfade loop in each sample, cut the silence before each sound, and converted the files to 16-bit FLAC."},
  {"id":"fluidr3-gm","title":"Fluid (R3) SoundFont","creator":"Frank Wen","license":"MIT","source":"https://sources.debian.org/src/fluid-soundfont/3.1-6/","licenseUri":"https://opensource.org/license/mit","also":null,"changes":"Took 18 instrument presets (General MIDI 12, 13, 17 to 21, 25, 26, 28, 31, 33, 35, 46, 57, 62, 66 and 74) and 12 keys of the Brush drum kit out of the SoundFont: joined each left and right sample pair and the layers that sound together into one file, kept one velocity layer where the layers play the same samples, cut the samples at the loop end and the silence before each sound, baked the hold and decay of the volume envelope into the samples (repeating the loop where the decay needs it) and, in four presets, the filter, moved the stereo halves of three drums tuned 5 cents apart to one pitch, converted the files to 16-bit FLAC raised to -1 dBFS (the level is restored at playback), and left out the other filters, the filter sweeps, the LFOs, the chorus and reverb sends, the envelope delay and the velocity-to-filter modulators; a short decay to a lower sustain level became a lower level."}
 ],
